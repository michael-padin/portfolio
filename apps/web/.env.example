# =============================================
# SANITY CMS
# =============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_read_token
SANITY_API_BROWSER_TOKEN=your_browser_token
SANITY_REVALIDATE_SECRET=your_webhook_secret

# =============================================
# SITE CONFIG
# =============================================
NEXT_PUBLIC_SITE_URL=https://michaelpadin.com

# =============================================
# AI (server-side only)
# =============================================
# Chatbot — Gemini via Vercel AI SDK. Free tier at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Contact form lead scoring still uses Claude Haiku.
ANTHROPIC_API_KEY=your_anthropic_api_key

# =============================================
# EMAIL (Resend)
# =============================================
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=hello@michaelpadin.com

# =============================================
# TELEGRAM (visit, chat & lead alerts — server-side only)
# =============================================
# Bot token from @BotFather. Leave token or chat id empty to disable the feed.
TELEGRAM_BOT_TOKEN=your_bot_token
# Supergroup id (starts with -100). Topic ids are optional; unset ones post to General.
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_TOPIC_VISITS=
TELEGRAM_TOPIC_CHATS=
TELEGRAM_TOPIC_LEADS=
TELEGRAM_TOPIC_ERRORS=

# =============================================
# CLOUDFLARE TURNSTILE (contact form)
# =============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# =============================================
# FEATURE FLAGS (set to "true" to enable)
# =============================================
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_ENABLE_BLOG=false
NEXT_PUBLIC_ENABLE_CONTACT=true

# =============================================
# ANALYTICS
# =============================================
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
